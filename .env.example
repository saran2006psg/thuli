# ─────────────────────────────────────────────────────────────────────────────
# PS2 – Stump the Model  |  .env.example
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Phase 1: Data Source ─────────────────────────────────────────────────────
# Primary source:  "huggingface"  |  "kaggle"
DATA_SOURCE=huggingface

# HuggingFace dataset (used when DATA_SOURCE=huggingface)
HF_DATASET_NAME=ashraq/fashion-product-images-small
HF_SPLIT=train

# Kaggle dataset slug (used when DATA_SOURCE=kaggle)
# Your kaggle.json must be at ~/.kaggle/kaggle.json
KAGGLE_DATASET=PromptCloudHQ/all-products-from-katespadeny

# ── Paths ─────────────────────────────────────────────────────────────────────
RAW_CATALOGUE_CSV=data/raw_catalogue.csv
CATALOGUE_CSV=data/catalogue.csv
CATALOGUE_IMG_DIR=data/catalogue
REJECTED_CSV=data/rejected.csv

# ── Cleaning thresholds ───────────────────────────────────────────────────────
CATALOGUE_MIN_SIZE=5000          # minimum clean items required
IMAGE_MIN_DIMENSION=64           # reject images smaller than this (px)

# ── Phase 2: Embeddings ───────────────────────────────────────────────────────
# ENCODER_MODEL=openai/clip-vit-base-patch32
# EMBEDDING_DIM=512
# BATCH_SIZE=64
# EMBEDDINGS_PATH=artifacts/embeddings/catalogue_embeddings.npy
# PRODUCT_IDS_PATH=artifacts/embeddings/product_ids.json

# ── Phase 3: FAISS ────────────────────────────────────────────────────────────
# FAISS_INDEX_PATH=artifacts/indexes/catalogue.faiss
# FAISS_INDEX_TYPE=Flat          # Flat | IVF | HNSW

# ── Phase 4+: Matcher ─────────────────────────────────────────────────────────
# SIMILARITY_THRESHOLD=0.75      # τ — calibrated in Phase 4/10
# TOP_K=5
