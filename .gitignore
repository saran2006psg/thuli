# .gitignore

# Data — images are large; don't track them
data/catalogue/
data/raw_catalogue.csv
data/sources/**/images/
# (source_info.json and README.md inside sources/ ARE tracked)

# Artifacts — generated offline
artifacts/

# Environment
.env

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# Kaggle temp
.kaggle_tmp/

# HuggingFace cache
~/.cache/huggingface/
.cache/

# OS
.DS_Store
Thumbs.db
